#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// Network Mode Selection
// Uncomment ONE of these to choose your network connection:
// #define USE_ETHERNET    // Use Ethernet port on Machine Control (experimental - see docs/ETHERNET_TROUBLESHOOTING.md)
// If neither is defined, WiFi will be used (default)

// WiFi Credentials (for connecting to your network)
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Access Point Credentials (DISABLED - using WiFi-only mode)
// AP mode has been removed in favor of simplified WiFi-only configuration
// #define AP_SSID "PORTENTA-MQTT"
// #define AP_PASSWORD "portenta123"

// MQTT Broker Configuration
#define MQTT_BROKER "192.168.1.100"           // IP address or hostname of MQTT broker
#define MQTT_PORT 1883                        // Standard MQTT port (1883 = no TLS, 8883 = with TLS)
#define MQTT_USERNAME "your-mqtt-username"    // MQTT broker username (or "" for no auth)
#define MQTT_PASSWORD "your-mqtt-password"    // MQTT broker password (or "" for no auth)
#define MQTT_CLIENT_ID "portenta-controller"  // Unique client ID for this device

// Web Server Credentials
#define WEB_USERNAME "admin"
#define WEB_PASSWORD "password"
#define WEB_PORT 80

// Security Notes:
// - NEVER commit this file to git (it's in .gitignore)
// - Use strong passwords for production deployments
// - Consider enabling TLS/SSL on MQTT broker for production (port 8883)
// - Rotate credentials regularly
// - See docs/SECURITY_RECOMMENDATIONS.md for more information

#endif // CREDENTIALS_H
